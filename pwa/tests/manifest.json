{
  "schema": 1,
  "rev": 1,
  "title": {
    "ru": "Помощь при работе с мышью",
    "en": "Mouse assistance"
  },
  "pages": [
    {
      "id": "main",
      "title": {
        "ru": "Помощь",
        "en": "Assistance"
      },
      "controls": [
        {
          "id": "assist",
          "type": "toggle",
          "key": "assist.on",
          "confirm": "revert",
          "label": {
            "ru": "Помощь",
            "en": "Assistance"
          },
          "help": {
            "ru": "Включает коррекцию движения мыши. Если станет хуже, нажмите «Вернуть».",
            "en": "Turns the pointer correction on. If it gets worse, press Undo."
          }
        },
        {
          "id": "strength",
          "type": "stepper",
          "key": "assist.strength",
          "min": 0,
          "max": 10,
          "marks": {
            "0": {
              "ru": "Выкл",
              "en": "Off"
            },
            "5": {
              "ru": "Как рекомендует профиль",
              "en": "As the profile recommends"
            },
            "10": {
              "ru": "Максимум",
              "en": "Maximum"
            }
          },
          "confirm": "revert",
          "label": {
            "ru": "Сила помощи",
            "en": "Assistance strength"
          },
          "help": {
            "ru": "Насколько сильно помощь тормозит курсор у кнопок и значков.",
            "en": "How strongly the pointer is slowed near buttons and icons."
          }
        },
        {
          "id": "tremor",
          "type": "stepper",
          "key": "tremor.level",
          "min": 0,
          "max": 10,
          "marks": {
            "0": {
              "ru": "Выкл",
              "en": "Off"
            },
            "5": {
              "ru": "Как рекомендует профиль",
              "en": "As the profile recommends"
            },
            "10": {
              "ru": "Максимум",
              "en": "Maximum"
            }
          },
          "confirm": "revert",
          "label": {
            "ru": "Подавление дрожи",
            "en": "Tremor filter"
          },
          "help": {
            "ru": "Насколько сильно убирается дрожь руки. Само движение не добавляется.",
            "en": "How much hand tremor is taken out. No motion is ever added."
          }
        }
      ]
    },
    {
      "id": "profile",
      "title": {
        "ru": "Профиль",
        "en": "Profile"
      },
      "controls": [
        {
          "id": "fill",
          "type": "meter",
          "key": "profile.fill",
          "min": 0,
          "max": 100,
          "fmt": "{v} %",
          "label": {
            "ru": "Профиль собран",
            "en": "Profile collected"
          },
          "help": {
            "ru": "Сколько наблюдений уже накоплено. Это не оценка качества.",
            "en": "How many observations were collected. Not a quality score."
          }
        },
        {
          "id": "layers",
          "type": "status",
          "key": "profile.layers",
          "map": {
            "none": {
              "ru": "Данных пока мало",
              "en": "Not enough data yet"
            },
            "asc": {
              "ru": "Готова помощь при движении",
              "en": "Movement help is ready"
            },
            "tremor": {
              "ru": "Готово подавление дрожи",
              "en": "Tremor filter is ready"
            },
            "both": {
              "ru": "Готово всё",
              "en": "Everything is ready"
            }
          },
          "label": {
            "ru": "Что уже готово",
            "en": "What is ready"
          }
        },
        {
          "id": "calib",
          "type": "toggle",
          "key": "calib.running",
          "confirm": "none",
          "label": {
            "ru": "Калибровка",
            "en": "Calibration"
          },
          "help": {
            "ru": "Пока идёт калибровка, помощь выключена: устройство изучает ваши обычные движения. Работайте с мышью как всегда.",
            "en": "While calibrating, assistance is off: the device learns your usual movements. Use the mouse as always."
          }
        },
        {
          "id": "import",
          "type": "file",
          "op": "bundle_put",
          "accept": ".dobundle",
          "max_bytes": 16000,
          "label": {
            "ru": "Загрузить файл настроек",
            "en": "Load a settings file"
          },
          "help": {
            "ru": "Откроется только файл, сделанный для этого устройства. Из устройства профиль не выгружается никуда.",
            "en": "Only a file made for this device will open. The profile is never taken out of the device."
          }
        },
        {
          "id": "restore",
          "type": "action",
          "key": "profile.restore",
          "confirm": "two-step",
          "label": {
            "ru": "Вернуть прежний профиль",
            "en": "Restore the previous profile"
          }
        },
        {
          "id": "slot_name",
          "type": "text",
          "key": "slot.name",
          "maxlen": 24,
          "label": {
            "ru": "Название слота",
            "en": "Slot name"
          },
          "help": {
            "ru": "Например «Работа» или «Браузер». Название видно только на этом устройстве и в телефоне.",
            "en": "For example \"Work\" or \"Browser\". Shown only on this device and in the phone."
          }
        },
        {
          "id": "slot_clear",
          "type": "action",
          "key": "slot.clear",
          "confirm": "two-step",
          "danger": true,
          "label": {
            "ru": "Очистить этот слот",
            "en": "Clear this slot"
          },
          "help": {
            "ru": "Стирает профиль, уровни и название только в этом слоте. Помощь выключится. Нужна кнопка на устройстве.",
            "en": "Erases the profile, levels and name of this slot only. Assistance turns off. Needs the button on the device."
          }
        }
      ]
    },
    {
      "id": "more",
      "title": {
        "ru": "Ещё",
        "en": "More"
      },
      "controls": [
        {
          "id": "serial",
          "type": "status",
          "key": "device.serial",
          "label": {
            "ru": "Серийный номер (как на наклейке)",
            "en": "Serial number (as on the label)"
          }
        },
        {
          "id": "device_id",
          "type": "status",
          "key": "device.id",
          "label": {
            "ru": "Номер владельца (меняется заводским сбросом)",
            "en": "Owner number (changes with a factory reset)"
          }
        },
        {
          "id": "trusted",
          "type": "status",
          "key": "trusted.count",
          "label": {
            "ru": "Откуда принимаются файлы (кроме своих копий)",
            "en": "Where files are accepted from (besides your own copies)"
          }
        },
        {
          "id": "card",
          "type": "file",
          "op": "card_get",
          "accept": ".docard",
          "max_bytes": 4096,
          "label": {
            "ru": "Сохранить карточку устройства",
            "en": "Save the device card"
          },
          "help": {
            "ru": "Карточку можно передавать: по ней нельзя прочитать ничего личного, можно только подготовить файл для этого устройства.",
            "en": "The card is safe to share: it reveals nothing personal, it only lets a file be prepared for this device."
          }
        },
        {
          "id": "fw_version",
          "type": "status",
          "key": "fw.version",
          "label": {
            "ru": "Версия прошивки",
            "en": "Firmware version"
          }
        },
        {
          "id": "fw_state",
          "type": "status",
          "key": "fw.state",
          "map": {
            "unsupported": {
              "ru": "Обновление не поддерживается",
              "en": "Updates are not supported"
            },
            "current": {
              "ru": "Установлена, обновлений нет",
              "en": "Installed, nothing pending"
            },
            "staged": {
              "ru": "Загружено, ждёт применения",
              "en": "Loaded, waiting to be applied"
            },
            "trial": {
              "ru": "Новая версия проверяется",
              "en": "The new version is being checked"
            }
          },
          "label": {
            "ru": "Обновление",
            "en": "Update"
          }
        },
        {
          "id": "fw_put",
          "type": "file",
          "op": "fw_put",
          "accept": ".dofw",
          "max_bytes": 4194304,
          "label": {
            "ru": "Загрузить обновление прошивки",
            "en": "Load a firmware update"
          },
          "help": {
            "ru": "Файл должен быть подписан производителем. Он ложится во вторую область памяти, пока работает прежняя версия.",
            "en": "The file must be signed by the manufacturer. It goes into the second memory bank while the current version keeps running."
          }
        },
        {
          "id": "fw_apply",
          "type": "action",
          "key": "fw.apply",
          "confirm": "two-step",
          "label": {
            "ru": "Применить обновление",
            "en": "Apply the update"
          },
          "help": {
            "ru": "Устройство перезапустится; если новая версия не заработает, прежняя вернётся сама. Нужна кнопка на устройстве.",
            "en": "The device restarts; if the new version does not work, the previous one comes back. Needs the button on the device."
          }
        },
        {
          "id": "fw_rollback",
          "type": "action",
          "key": "fw.rollback",
          "confirm": "two-step",
          "label": {
            "ru": "Вернуть прежнюю версию",
            "en": "Go back to the previous version"
          },
          "help": {
            "ru": "Потребуется нажать кнопку на устройстве.",
            "en": "You will need to press the button on the device."
          }
        },
        {
          "id": "pkg_state",
          "type": "status",
          "key": "pkg.state",
          "map": {
            "none": {
              "ru": "Пакета нет",
              "en": "No package"
            },
            "receiving": {
              "ru": "Загружается",
              "en": "Loading"
            },
            "pending": {
              "ru": "Проверен, ждёт применения",
              "en": "Checked, waiting"
            }
          },
          "label": {
            "ru": "Пакет для слотов",
            "en": "Package for the slots"
          }
        },
        {
          "id": "pkg_put",
          "type": "file",
          "op": "pkg_put",
          "accept": ".dopk",
          "max_bytes": 22020096,
          "label": {
            "ru": "Загрузить пакет",
            "en": "Load a package"
          },
          "help": {
            "ru": "Только для этого устройства. Сначала проверка, применение отдельно.",
            "en": "For this device only. Checked first, applied separately."
          }
        },
        {
          "id": "pkg_apply",
          "type": "action",
          "key": "pkg.apply",
          "confirm": "two-step",
          "label": {
            "ru": "Применить пакет",
            "en": "Apply the package"
          },
          "help": {
            "ru": "Может понадобиться кнопка на устройстве.",
            "en": "The button on the device may be needed."
          }
        },
        {
          "id": "pkg_discard",
          "type": "action",
          "key": "pkg.discard",
          "confirm": "none",
          "label": {
            "ru": "Отменить пакет",
            "en": "Drop the package"
          }
        },
        {
          "id": "model_state",
          "type": "status",
          "key": "model.state",
          "map": {
            "none": {
              "ru": "Своей нет",
              "en": "None of its own"
            },
            "ok": {
              "ru": "Установлена",
              "en": "Installed"
            },
            "needs_system": {
              "ru": "Нужна новая система",
              "en": "Needs a newer system"
            }
          },
          "label": {
            "ru": "Модель значков в слоте",
            "en": "Icon model in this slot"
          }
        },
        {
          "id": "model_revert",
          "type": "action",
          "key": "pkg.revert",
          "confirm": "two-step",
          "label": {
            "ru": "Вернуть прежнюю модель",
            "en": "Previous model"
          }
        },
        {
          "id": "forget",
          "type": "action",
          "key": "pairing.forget",
          "confirm": "two-step",
          "danger": true,
          "label": {
            "ru": "Забыть все телефоны",
            "en": "Forget all phones"
          },
          "help": {
            "ru": "Потребуется нажать кнопку на самом устройстве.",
            "en": "You will need to press the button on the device itself."
          }
        },
        {
          "id": "erase",
          "type": "action",
          "key": "erase.profile",
          "confirm": "two-step",
          "danger": true,
          "label": {
            "ru": "Стереть личные данные (все слоты)",
            "en": "Erase personal data (all slots)"
          },
          "help": {
            "ru": "Удаляет профили, настройки и доверенных во всех слотах; помощь выключится. Нужна кнопка на устройстве или удержание 10 с.",
            "en": "Deletes profiles, settings and trusted senders in every slot; assistance turns off. Needs the button, or holding it for 10 s."
          }
        },
        {
          "id": "factory",
          "type": "action",
          "key": "factory.reset",
          "confirm": "two-step",
          "danger": true,
          "label": {
            "ru": "Заводской сброс",
            "en": "Factory reset"
          },
          "help": {
            "ru": "То же, и новый номер владельца (серийный остаётся): старые файлы не откроются, телефоны забываются. Нужна кнопка или удержание 20 с.",
            "en": "The same, plus a new owner number (the serial stays): old files stop opening, phones are forgotten. Needs the button, or holding it for 20 s."
          }
        }
      ]
    }
  ]
}
